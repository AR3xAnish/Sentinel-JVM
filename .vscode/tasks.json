{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Launch Full Sentinel-JVM Stack",
      "type": "shell",
      "command": "python run_stack.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "React Dashboard: Dev Server (Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/dashboard"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Gateway: Maven Package (JAR)",
      "type": "shell",
      "command": "mvn package -DskipTests",
      "options": {
        "cwd": "${workspaceFolder}/gateway"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Docker Compose: Start Full Stack",
      "type": "shell",
      "command": "docker-compose up --build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Gateway: Run Spring Boot JAR",
      "type": "shell",
      "command": "java -jar target/sentinel-gateway-1.0.0.jar",
      "options": {
        "cwd": "${workspaceFolder}/gateway"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Docker Compose: Stop Stack",
      "type": "shell",
      "command": "docker-compose down",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
